<span id="temp">xx°C</span>

<script>
    const loadWeather = async () => {
        const endpoint =
            "https://api.open-meteo.com/v1/forecast?latitude=38.7251&longitude=-9.1498&current=temperature_2m&timezone=Europe%2FLondon&forecast_days=1";

        const temp = document.querySelector("#temp");

        try {
            const res = await fetch(endpoint);
            const data = await res.json();

            temp.textContent = `${Math.round(data.current.temperature_2m)}${data.current_units.temperature_2m}`;
        } catch (err) {
            temp.textContent = "xx°c";
            console.error("Failed to fetch weather:", err);
        }
    };

    requestAnimationFrame(loadWeather);
</script>
